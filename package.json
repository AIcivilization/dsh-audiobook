{
  "name": "dsh-audiobook",
  "version": "0.1.0",
  "description": "Turn any book into an audiobook inside DSH: import EPUB / PDF / TXT / DOCX / Markdown and listen in the sidebar, with Microsoft Edge neural voices, offline Kokoro or your device's voices, adjustable speed, and resume where you left off. · 搜书听：导入一本书，在 DSH 右侧栏读给你听，音色、语速可选，自动记住听到哪。DeepSeek Harness (dsh) 插件。",
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "deepseek",
    "cordis",
    "audiobook",
    "read-aloud",
    "text-to-speech",
    "tts",
    "ebook",
    "epub",
    "pdf",
    "txt",
    "book-reader",
    "edge-tts",
    "kokoro",
    "sherpa-onnx",
    "听书",
    "有声书",
    "朗读",
    "搜书听",
    "tingshu"
  ],
  "license": "MIT",
  "author": "AIcivilization",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-audiobook.git"
  },
  "homepage": "https://github.com/AIcivilization/dsh-audiobook#readme",
  "bugs": {
    "url": "https://github.com/AIcivilization/dsh-audiobook/issues"
  },
  "type": "module",
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-audiobook": "bin/dsh-audiobook.js"
  },
  "files": [
    "bin",
    "lib",
    "plugin",
    "web",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.8",
    "unpdf": "1.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
